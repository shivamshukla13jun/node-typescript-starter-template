# Public URL of this frontend — used for SEO metadata (og:url, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# API base URL used by the SecureApiClient. Leave empty to call same-origin
# (works with the dev proxy in next.config.mjs and any reverse proxy).
NEXT_PUBLIC_API_URL=

# Where the dev proxy forwards /api/* and /encryption/*
API_PROXY_TARGET=http://localhost:3000
